<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- This ensures the logo has enough padding and doesn't get cropped/sharded by the OS -->
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/splash_logo_img"
            android:gravity="center"
            android:mipMap="true" />
    </item>
</layer-list>
